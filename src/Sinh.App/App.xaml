<Application xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes" x:Class="Sinh.App.App">
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <materialDesign:BundledTheme BaseTheme="Light" PrimaryColor="DeepPurple" SecondaryColor="Teal"/>
        <ResourceDictionary Source="pack://application:,,,/MaterialDesignThemes.Wpf;component/Themes/MaterialDesign3.Defaults.xaml"/>
      </ResourceDictionary.MergedDictionaries>
      <BooleanToVisibilityConverter x:Key="BoolVisibility"/>
      <SolidColorBrush x:Key="Surface" Color="#F5F6FA"/>
      <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
      <SolidColorBrush x:Key="Ink" Color="#202235"/>
      <SolidColorBrush x:Key="Muted" Color="#62667D"/>
      <SolidColorBrush x:Key="Accent" Color="#6561D9"/>
      <SolidColorBrush x:Key="Line" Color="#DDE0EA"/>
      <Style TargetType="Window" BasedOn="{StaticResource MaterialDesignWindow}">
        <Setter Property="Background" Value="{DynamicResource WindowSurface}"/>
        <Setter Property="Foreground" Value="{DynamicResource Ink}"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        <Setter Property="Icon" Value="{DynamicResource AppIcon}"/>
      </Style>
      <Style TargetType="Button" BasedOn="{StaticResource MaterialDesignOutlinedButton}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="MinWidth" Value="48"/>
        <Setter Property="Padding" Value="14,6"/>
        <Setter Property="Margin" Value="0,0,8,0"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="TextBox" BasedOn="{StaticResource MaterialDesignOutlinedTextBox}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="Padding" Value="10"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="ComboBox" BasedOn="{StaticResource MaterialDesignOutlinedComboBox}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="CheckBox" BasedOn="{StaticResource MaterialDesignCheckBox}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="RadioButton" BasedOn="{StaticResource MaterialDesignChoiceChipRadioButton}">
        <Setter Property="MinHeight" Value="40"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="Expander" BasedOn="{StaticResource MaterialDesignExpander}">
        <Setter Property="Margin" Value="0,0,0,12"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Background" Value="{DynamicResource Panel}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource Line}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="TextBlock" BasedOn="{StaticResource MaterialDesignBodyMediumTextBlock}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
      </Style>
      <Style TargetType="DataGrid" BasedOn="{StaticResource MaterialDesignDataGrid}">
        <Setter Property="FontFamily" Value="{DynamicResource AppFontFamily}"/>
        <Setter Property="FontSize" Value="{DynamicResource AppFontSize}"/>
        <Setter Property="MinRowHeight" Value="40"/>
      </Style>
    </ResourceDictionary>
  </Application.Resources>
</Application>
